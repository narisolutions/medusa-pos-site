---
const base = import.meta.env.BASE_URL;
---

<section id="brindola" class="mx-auto max-w-6xl px-6 pb-20">
  <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 md:flex md:items-center md:justify-between md:gap-10">
    <div>
      <div class="flex items-center gap-3">
        <img src={`${base}brindola.svg`} alt="" class="h-10 w-10 shrink-0" />
        <h2 class="text-xl font-semibold">Not running a Medusa store?</h2>
      </div>
      <p class="mt-3 max-w-2xl text-[var(--color-text-secondary)]">
        Medusa POS is a front end for an existing MedusaJS backend. If you want a point of sale that stands on its own,
        with products, stock, kitchen displays and reports on your own devices and no server to host, try Brindola
        from the team behind Medusa POS. It keeps selling when the internet is down.
      </p>
    </div>
    <a
      href="https://brindola.com/"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-flex shrink-0 items-center gap-2 rounded-lg border border-[var(--color-border)] px-5 py-2.5 text-sm font-medium transition-colors hover:border-[var(--color-accent)]/40 md:mt-0"
    >
      Try Brindola
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/>
      </svg>
    </a>
  </div>
</section>
