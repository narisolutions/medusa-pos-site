---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Downloads from '../components/Downloads.astro';
import Compatibility from '../components/Compatibility.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Medusa POS — The touch-first till for MedusaJS"
  description="Free, open-source touchscreen POS for MedusaJS: checkout, every way to pay, returns and exchanges, cash register, receipts and orders on Windows, macOS and Linux."
>
  <Header />
  <main>
    <Hero />
    <Features />
    <Downloads />
    <Compatibility />
  </main>
  <Footer />
</Layout>
