---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { getPostBySlug, getAdjacentPosts } from '../../data/blog-posts';

const base = import.meta.env.BASE_URL;
const siteUrl = 'https://pos.nari.ge';
const slug = 'getting-started-with-medusa-pos';
const post = getPostBySlug(slug)!;
const { prev, next } = getAdjacentPosts(slug);
const publishedDateISO = post.publishedAt;
const modifiedDateISO = post.modifiedAt;
const publishedLabel = post.publishedLabel;
const articleUrl = `${siteUrl}/blog/${slug}`;
---

<Layout
  title="Getting Started with Medusa POS"
  description="A complete getting started guide for Medusa POS: setup requirements, installation, checkout flow, orders, settings, and FAQ."
  canonical={articleUrl}
  ogType="article"
  publishedTime={publishedDateISO}
  modifiedTime={modifiedDateISO}
>
  <Header variant="blog" />

  <main>
    <article class="editorial-wrapper mx-auto max-w-3xl px-6 py-11 text-left">
      <header class="mb-12 flex flex-col gap-4">
        <a
          href={`${base}blog`}
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] max-w-40 px-4 py-2 text-sm text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-text-secondary)]"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Back to blog
        </a>
      </header>

      <div class="editorial-content">
        <h1>Getting Started with Medusa POS</h1>
        <p class="mb-5 text-sm text-[var(--color-text-secondary)]">
          <time datetime={publishedDateISO}>Published {publishedLabel}</time>
          <span class="mx-2">·</span>
          <span>{post.readingTime}</span>
        </p>

        <h2>What you need</h2>
        <p><strong>To get started, you will need:</strong></p>
        <ul>
          <li>A Windows, macOS, or Linux computer at the checkout counter — a touchscreen is ideal</li>
          <li>
            A running <a href="https://medusajs.com/">Medusa</a> store (v2.21.x) with products and a sales channel set up
          </li>
          <li>Your Medusa Admin login (email and password)</li>
        </ul>
        <p><strong>Optional hardware (recommended for a full retail setup):</strong></p>
        <ul>
          <li>
            A <strong>thermal receipt printer</strong> - an 80 mm or 57 mm printer on your network (Wi-Fi or Ethernet), on USB,
            or added to your computer as a system printer (for example, Epson TM-series or BIXOLON models)
          </li>
          <li>
            A <strong>barcode scanner</strong> - any standard USB scanner that types like a keyboard, or one on a serial
            (COM) port
          </li>
          <li>
            A <strong>cash drawer</strong> - connected to your thermal printer via the standard RJ-11 cable
          </li>
        </ul>

        <hr />

        <h2>Get started - setup in minutes</h2>
        <ol>
          <li>
            <strong>Download and install</strong> the app from <a href="https://pos.nari.ge/">pos.nari.ge</a> - choose
            the version for your operating system.
          </li>
          <li>
            <strong>Enter your store address</strong> - on first launch, the app asks for your Medusa backend URL
            (for example, <code class="rounded bg-[var(--color-bg)] px-1.5 py-0.5 text-xs">https://admin.mystore.com</code>). Type it
            in and save. You can add more stores later from the store box on the sign-in screen.
          </li>
          <li>
            <strong>Sign in</strong> with your Medusa Admin email and password.
          </li>
          <li>
            <strong>Add your printer</strong> - open <strong>Settings -> Printers</strong>, tap <strong>Add printer</strong>,
            enter the printer's address, and run a test print. The printer then shows its live status - ready, out of
            paper or cover open - on the Printers page and in the top bar.
          </li>
          <li>
            <strong>Test the cash drawer</strong> - from the same printer settings screen, tap <strong>Test drawer</strong>.
            If a drawer is connected to the printer, it should pop open.
          </li>
          <li>
            <strong>Check your payment methods</strong> - under <strong>Settings -> Store</strong>, each payment method from
            your Medusa backend gets a name and an icon at the till: cash, card, bank transfer and more.
          </li>
          <li>
            <strong>Start selling</strong> - go to the Checkout screen, search or scan your first product, and you are ready.
          </li>
        </ol>

        <div data-theme-view="light">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/store-select-light.png`} alt="Choose your store at login" draggable="false" />
            <figcaption>Choose your store at login</figcaption>
          </figure>
        </div>
        <div data-theme-view="dark">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/store-select-dark.png`} alt="Choose your store at login" draggable="false" />
            <figcaption>Choose your store at login</figcaption>
          </figure>
        </div>

        <div data-theme-view="light">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/login-light.png`} alt="Sign in with your Medusa Admin credentials" draggable="false" />
            <figcaption>Sign in with your Medusa Admin credentials</figcaption>
          </figure>
        </div>
        <div data-theme-view="dark">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/login-dark.png`} alt="Sign in with your Medusa Admin credentials" draggable="false" />
            <figcaption>Sign in with your Medusa Admin credentials</figcaption>
          </figure>
        </div>

        <hr />

        <h2>Daily checkout flow</h2>
        <p>Once you are set up, a typical sale takes about 30 seconds:</p>
        <ol>
          <li>
            <strong>Pick your store and sign in.</strong> If you have more than one location, choose the right one
            from the store box, then enter your credentials.
          </li>
          <li>
            <strong>Find and add products.</strong> On the Checkout screen, scan the barcode on the product packaging
            or type the name in the search bar. You can also browse the catalog, or tap a quick key for your best sellers.
          </li>
        </ol>

        <div data-theme-view="light">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/checkout-light.png`} alt="Checkout: quick keys, the cart and the payment column in one view" draggable="false" />
            <figcaption>Checkout: quick keys, the cart and the payment column in one view</figcaption>
          </figure>
        </div>
        <div data-theme-view="dark">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/checkout-dark.png`} alt="Checkout: quick keys, the cart and the payment column in one view" draggable="false" />
            <figcaption>Checkout: quick keys, the cart and the payment column in one view</figcaption>
          </figure>
        </div>

        <ol start="3">
          <li>
            <strong>Review the cart.</strong> Change a quantity with the large - and + buttons or apply a discount. Removed
            something by mistake? Tap <strong>Undo</strong>.
          </li>
          <li>
            <strong>Tap Payment.</strong> Pick the payment method first. For cash, enter the amount received on the keypad
            and the change is shown in large numbers; for card or bank transfer, confirm once the payment has gone through.
          </li>
        </ol>

        <div data-theme-view="light">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/payment-light.png`} alt="Type the cash received on the keypad; the change is shown at once" draggable="false" />
            <figcaption>Type the cash received on the keypad; the change is shown at once</figcaption>
          </figure>
        </div>
        <div data-theme-view="dark">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/payment-dark.png`} alt="Type the cash received on the keypad; the change is shown at once" draggable="false" />
            <figcaption>Type the cash received on the keypad; the change is shown at once</figcaption>
          </figure>
        </div>

        <ol start="5">
          <li>
            <strong>Receipt prints; drawer opens if configured.</strong> The receipt prints right after payment, and a
            success screen shows the change to hand back. Tap <strong>New sale</strong>, or simply scan the next item.
          </li>
          <li>
            <strong>Order saved.</strong> The completed sale appears in your Medusa order history immediately.
          </li>
        </ol>

        <hr />

        <h2>Checking past orders</h2>
        <p>
          Every completed transaction is stored and searchable. Tap <strong>Orders</strong> in the sidebar to browse your
          sales history. Search, or tap a quick filter such as <strong>Unpaid</strong> or <strong>To fulfil</strong>, and
          tap any row to see the full detail - items, totals, payment and history.
        </p>
        <p>
          From the order page you can preview and reprint the receipt, save it as a PDF, take a payment later, refund,
          or handle a return or exchange.
        </p>

        <div data-theme-view="light">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/orders-light.png`} alt="Every order, with quick filters and its status at a glance" draggable="false" />
            <figcaption>Every order, with quick filters and its status at a glance</figcaption>
          </figure>
        </div>
        <div data-theme-view="dark">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/orders-dark.png`} alt="Every order, with quick filters and its status at a glance" draggable="false" />
            <figcaption>Every order, with quick filters and its status at a glance</figcaption>
          </figure>
        </div>

        <div data-theme-view="light">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/order-light.png`} alt="The order page: preview or reprint the receipt, refund, return or exchange" draggable="false" />
            <figcaption>The order page: preview or reprint the receipt, refund, return or exchange</figcaption>
          </figure>
        </div>
        <div data-theme-view="dark">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/order-dark.png`} alt="The order page: preview or reprint the receipt, refund, return or exchange" draggable="false" />
            <figcaption>The order page: preview or reprint the receipt, refund, return or exchange</figcaption>
          </figure>
        </div>

        <hr />

        <h2>Settings and printers</h2>
        <p>Everything you need to configure lives under <strong>Settings</strong>:</p>
        <ul>
          <li>
            <strong>Printers</strong> - add network, USB or system printers, mark a default, run a test print and test the
            cash drawer. Each printer shows its live status.
          </li>
          <li>
            <strong>Scanner</strong> - choose a keyboard-style or serial scanner, and scan anything to check it works.
          </li>
          <li>
            <strong>Connection</strong> - the sales channel and stock location this till sells from.
          </li>
          <li>
            <strong>Store</strong> - your name, address, phone number and logo (printed on every receipt), the payment
            methods, and your bank details for bank transfers.
          </li>
          <li>
            <strong>Quick keys</strong> - pin up to eight products as one-tap buttons above the cart.
          </li>
          <li>
            <strong>Preferences</strong> - language, theme (Light, Dark or System), display size, sounds, currency and date
            format, and the cash register.
          </li>
        </ul>

        <div data-theme-view="light">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/printer-settings-light.png`} alt="Each printer shows its live status; test print and drawer from the same row" draggable="false" />
            <figcaption>Each printer shows its live status; test print and drawer from the same row</figcaption>
          </figure>
        </div>
        <div data-theme-view="dark">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/printer-settings-dark.png`} alt="Each printer shows its live status; test print and drawer from the same row" draggable="false" />
            <figcaption>Each printer shows its live status; test print and drawer from the same row</figcaption>
          </figure>
        </div>

        <div data-theme-view="light">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/preferences-settings-light.png`} alt="Language, theme, display size and sounds for this till" draggable="false" />
            <figcaption>Language, theme, display size and sounds for this till</figcaption>
          </figure>
        </div>
        <div data-theme-view="dark">
          <figure class="editorial-figure">
            <img src={`${base}screenshots/preferences-settings-dark.png`} alt="Language, theme, display size and sounds for this till" draggable="false" />
            <figcaption>Language, theme, display size and sounds for this till</figcaption>
          </figure>
        </div>

        <hr />

        <h2>FAQ</h2>
        <p><strong>Why does Windows or macOS show a warning when I install the app?</strong></p>
        <p>
          The Windows installer is code-signed, but SmartScreen may still ask once while the signature builds its
          reputation. The macOS app is not notarized yet, so macOS asks too. If you downloaded the file from
          <a href="https://pos.nari.ge/">pos.nari.ge</a>, you can safely proceed.
        </p>
        <p><strong>What printers are compatible?</strong></p>
        <p>
          Any 80 mm or 57 mm thermal receipt printer that speaks ESC/POS - on your network (port 9100), on USB, or set up
          on your computer as a system printer. For example, Epson TM-series or BIXOLON printers. <em>Thermal printer =
          the till-roll type that prints receipts without ink cartridges.</em>
        </p>
        <p><strong>Is barcode scanning required?</strong></p>
        <p>
          No - it is completely optional. Any product can be found and added using the search bar. A USB scanner that types like a keyboard works straight away; a serial (COM) scanner is chosen under Settings -> Scanner. Full barcode-to-product lookup additionally requires the optional <a href="https://github.com/narisolutions/medusa-plugins" target="_blank" rel="noopener noreferrer">@narisolutions/medusa-plugin-pos</a> companion plugin installed on your Medusa server.
        </p>
        <p><strong>Does the cash drawer always open after a sale?</strong></p>
        <p>
          It opens when configured correctly: the cash drawer must be connected to your thermal printer via the standard cable, and the printer must be set up in <strong>Settings -> Printers</strong>. When those conditions are met, the app sends the open command to the printer at the end of a completed sale.
        </p>
        <p><strong>Does it work on a touchscreen?</strong></p>
        <p>
          Yes - it is designed for one. Every button is large enough for a finger, amounts are entered on a keypad, and a
          display size setting makes everything bigger or smaller to suit your screen. It runs on Windows, macOS and Linux
          computers, including touchscreen all-in-one tills.
        </p>

        <section class="mt-12">
          <h2>Where to go next</h2>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={`${base}#downloads`}
              class="rounded-lg bg-[var(--color-accent)] px-5 py-2.5 font-medium no-underline transition-colors hover:bg-[var(--color-accent-hover)]"
              style="color: #fff;"
            >
              Download Medusa POS
            </a>
            <a
              href="https://github.com/narisolutions/medusa-pos"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-[var(--color-border)] px-5 py-2.5 font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-text-secondary)]"
            >
              View on GitHub
            </a>
          </div>
        </section>
      </div>

      {(prev || next) && (
        <nav class="mt-14 grid grid-cols-1 gap-4 border-t border-[var(--color-border)] pt-8 sm:grid-cols-2" aria-label="Adjacent articles">
          {prev ? (
            <a
              href={`${base}blog/${prev.slug}`}
              class="group flex flex-col gap-1 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-colors hover:border-[var(--color-text-secondary)]"
            >
              <span class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-secondary)]">Previous</span>
              <span class="font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)]">{prev.title}</span>
              <span class="text-sm text-[var(--color-text-secondary)]">{prev.readingTime}</span>
            </a>
          ) : <div />}
          {next ? (
            <a
              href={`${base}blog/${next.slug}`}
              class="group flex flex-col gap-1 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-right transition-colors hover:border-[var(--color-text-secondary)]"
            >
              <span class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-secondary)]">Next</span>
              <span class="font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)]">{next.title}</span>
              <span class="text-sm text-[var(--color-text-secondary)]">{next.readingTime}</span>
            </a>
          ) : <div />}
        </nav>
      )}

      <!-- Lightbox (zoom on click for article screenshots) -->
      <div id="blog-lightbox" class="lightbox is-hidden" role="dialog" aria-modal="true" aria-label="Screenshot viewer">
        <div id="blog-lightbox-backdrop" class="lightbox-backdrop"></div>
        <button id="blog-lightbox-close" class="lightbox-close" aria-label="Close">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>

        <div class="lightbox-inner">
          <button id="blog-lightbox-prev" class="lightbox-nav" aria-label="Previous screenshot">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <img id="blog-lightbox-img" src="" alt="" class="lightbox-img" draggable="false" />
          <button id="blog-lightbox-next" class="lightbox-nav" aria-label="Next screenshot">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
        <p id="blog-lightbox-counter" class="lightbox-counter"></p>
      </div>

      <style is:global>
        .lightbox {
          position: fixed;
          inset: 0;
          z-index: 9999;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
        }
        .lightbox.is-hidden { display: none; }
        .lightbox-backdrop {
          position: absolute;
          inset: 0;
          background: rgba(0, 0, 0, 0.88);
          cursor: pointer;
        }
        .lightbox-close {
          position: absolute;
          top: 16px;
          right: 16px;
          z-index: 1;
          width: 40px;
          height: 40px;
          border-radius: 50%;
          background: rgba(255, 255, 255, 0.1);
          border: 1px solid rgba(255, 255, 255, 0.2);
          color: #fff;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: background 150ms;
        }
        .lightbox-close:hover { background: rgba(255, 255, 255, 0.22); }
        .lightbox-inner {
          position: relative;
          z-index: 1;
          display: flex;
          align-items: center;
          gap: 16px;
        }
        .lightbox-img {
          max-width: calc(100vw - 160px);
          max-height: calc(100vh - 96px);
          width: auto;
          height: auto;
          object-fit: contain;
          border-radius: 8px;
          box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
          display: block;
        }
        .lightbox-nav {
          flex-shrink: 0;
          width: 48px;
          height: 48px;
          border-radius: 50%;
          background: rgba(255, 255, 255, 0.1);
          border: 1px solid rgba(255, 255, 255, 0.2);
          color: #fff;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: background 150ms;
        }
        .lightbox-nav:hover { background: rgba(255, 255, 255, 0.22); }
        .lightbox-counter {
          position: absolute;
          bottom: 20px;
          left: 50%;
          transform: translateX(-50%);
          z-index: 1;
          color: rgba(255, 255, 255, 0.6);
          font-size: 13px;
          letter-spacing: 0.05em;
          pointer-events: none;
        }
      </style>

      <script is:inline>
        (function () {
          var lightbox = document.getElementById('blog-lightbox');
          if (!lightbox) return;

          var lightboxImg = document.getElementById('blog-lightbox-img');
          var lightboxCounter = document.getElementById('blog-lightbox-counter');
          var lightboxClose = document.getElementById('blog-lightbox-close');
          var lightboxPrev = document.getElementById('blog-lightbox-prev');
          var lightboxNext = document.getElementById('blog-lightbox-next');
          var lightboxBackdrop = document.getElementById('blog-lightbox-backdrop');

          var lbImages = [];
          var lbIndex = 0;

          function activeTheme() {
            return document.documentElement.dataset.theme || 'dark';
          }

          function getImagesForActiveTheme() {
            var theme = activeTheme();
            return Array.from(
              document.querySelectorAll(
                '.editorial-content [data-theme-view="' +
                  theme +
                  '"] figure.editorial-figure img'
              )
            );
          }

          function updateLightbox() {
            if (!lbImages.length) return;
            var img = lbImages[lbIndex];
            lightboxImg.src = img.src;
            lightboxImg.alt = img.alt || '';
            lightboxCounter.textContent = lbIndex + 1 + ' / ' + lbImages.length;
          }

          function openLightbox(images, index) {
            lbImages = images;
            lbIndex = index;
            updateLightbox();
            lightbox.classList.remove('is-hidden');
            document.body.style.overflow = 'hidden';
          }

          function closeLightbox() {
            lightbox.classList.add('is-hidden');
            document.body.style.overflow = '';
          }

          function lbNav(dir) {
            if (!lbImages.length) return;
            lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
            updateLightbox();
          }

          var allScreenshotImgs = Array.from(
            document.querySelectorAll('.editorial-content [data-theme-view] figure.editorial-figure img')
          );

          allScreenshotImgs.forEach(function (img) {
            img.addEventListener('click', function () {
              var images = getImagesForActiveTheme();
              if (!images.length) return;
              var index = images.findIndex(function (x) {
                return x.src === img.src;
              });
              openLightbox(images, index >= 0 ? index : 0);
            });
          });

          if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
          if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);
          if (lightboxPrev) lightboxPrev.addEventListener('click', function () { lbNav(-1); });
          if (lightboxNext) lightboxNext.addEventListener('click', function () { lbNav(1); });

          document.addEventListener('keydown', function (e) {
            if (!lightbox || lightbox.classList.contains('is-hidden')) return;
            if (e.key === 'Escape') closeLightbox();
            else if (e.key === 'ArrowLeft') lbNav(-1);
            else if (e.key === 'ArrowRight') lbNav(1);
          });
        })();
      </script>

      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: 'Getting Started with Medusa POS',
          datePublished: publishedDateISO,
          dateModified: modifiedDateISO,
          description:
            'A complete getting started guide for Medusa POS: setup requirements, installation, checkout flow, orders, settings, and FAQ.',
          url: articleUrl,
          mainEntityOfPage: articleUrl,
          author: {
            '@type': 'Organization',
            name: 'Nari Solutions',
            url: 'https://nari.ge',
          },
          publisher: {
            '@type': 'Organization',
            name: 'Nari Solutions',
          },
        })}
      />
    </article>
  </main>

  <Footer compact />
</Layout>
